#!/usr/bin/env bash
# Decide what a respond run should do: fix round, escalate, or nothing.
#
# Usage:   review-loop-gate <pr-number> <loop|human>
# Env:     GH_TOKEN, GITHUB_REPOSITORY — required
#          GITHUB_OUTPUT               — `action` (+ `round` on action=round) appended, when set
# Output:  action=skip|round|escalate   round=N (N=0 marks a human-triggered round:
#          never recorded, never capped — the human is their own round counter)
# Exit:    0 on a decision; 1 when the PR state is unreadable (fail loudly — a blind
#          loop must never guess a round).
#
# Runs inside the PR branch checkout, with GH_TOKEN the workflow's GITHUB_TOKEN. There is no
# stored counter: each round this gate starts leaves a `review-loop-round:<head-sha>` comment, and
# the budget is those markers on commits since (and including) the last human-authored one — a
# human commit resets the budget. Only markers the workflow token posted count: a commit's author
# and trailers are whatever the pusher typed, and anyone can comment, but only a workflow run can
# comment as that token's login. Bot commits carry the `[bot]` suffix in their author email.
#
# For `loop`, every guard keys off the PR's CURRENT state rather than the triggering
# event, so queued duplicate triggers self-neutralize.
set -euo pipefail

MAX_ROUNDS=3
# The author of every comment posted with a workflow run's GITHUB_TOKEN.
JOB_LOGIN="github-actions[bot]"

pr="${1:?usage: review-loop-gate <pr-number> <loop|human>}"
source="${2:?usage: review-loop-gate <pr-number> <loop|human>}"
: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
: "${GH_TOKEN:?GH_TOKEN is required}"

emit() {
  if [ -n "${GITHUB_OUTPUT:-}" ]; then
    echo "action=$1" >> "$GITHUB_OUTPUT"
    [ -z "${2:-}" ] || echo "round=$2" >> "$GITHUB_OUTPUT"
  fi
  echo "review-loop gate for PR #$pr ($source): action=$1${2:+ round=$2}${3:+ — $3}"
}

case "$source" in
  human) emit round 0 "human rounds are neither counted nor capped"; exit 0 ;;
  loop) ;;
  *) echo "::error::invalid source '$source' (want loop|human)"; exit 1 ;;
esac
team=$(korg-config linear.team)
[ -n "$team" ] || { echo "::error::linear.team is not set in .korg.yml"; exit 1; }

view=$(gh pr view "$pr" --repo "$GITHUB_REPOSITORY" --json state,baseRefName,headRefName,headRefOid,labels) \
  || { echo "::error::could not read PR #$pr"; exit 1; }
state=$(jq -r '.state' <<<"$view")
base=$(jq -r '.baseRefName' <<<"$view")
head_ref=$(jq -r '.headRefName' <<<"$view")
head_sha=$(jq -r '.headRefOid' <<<"$view")

[ "$state" = "OPEN" ] || { emit skip "" "PR is $state"; exit 0; }
case "$head_ref" in
  "agent/$team-"*) ;;
  *) emit skip "" "head branch '$head_ref' is not agent/$team-* — only dispatched PRs loop"; exit 0 ;;
esac

# no-auto-review: a human has taken review over. Only source=loop reaches here, so @claude
# rounds still run.
if jq -e '.labels | map(.name) | index("no-auto-review")' <<<"$view" > /dev/null; then
  emit skip "" "no-auto-review label present — reviews on this PR are manual"
  exit 0
fi

check=$(gh api "repos/$GITHUB_REPOSITORY/commits/$head_sha/check-runs?check_name=agent-review" \
  --jq '.check_runs | max_by(.id) // empty') \
  || { echo "::error::could not read check runs for $head_sha"; exit 1; }
[ -n "$check" ] || { emit skip "" "no agent-review check on the current head"; exit 0; }

check_status=$(jq -r '.status' <<<"$check")
conclusion=$(jq -r '.conclusion // empty' <<<"$check")
forced=$(jq -r '.external_id // empty' <<<"$check")
[ "$check_status" = "completed" ] || { emit skip "" "review of the current head is still running"; exit 0; }
[ "$conclusion" = "failure" ] || { emit skip "" "current verdict is '$conclusion', nothing to fix"; exit 0; }
[ "$forced" != "forced" ] || { emit skip "" "the review never published a verdict — no findings to fix"; exit 0; }

# A round that ends without pushing leaves a `pushless-round:<sha>` marker on the PR. Without a
# push the head does not change, so a duplicate trigger on that head would rerun a round that
# already found nothing it could change. Any author's marker counts here: stopping is the safe
# direction, and pr-comment-once would not post the job's own over a copy.
comments=$(gh api --paginate "repos/$GITHUB_REPOSITORY/issues/$pr/comments" \
  --jq '.[] | [.user.login, .body] | @json') \
  || { echo "::error::could not read comments on PR #$pr"; exit 1; }
if grep -qF -- "pushless-round:$head_sha" <<<"$comments"; then
  emit skip "" "a round on this head already ended without pushing — a human needs to act"
  exit 0
fi

# A marker on the current head is a round that started here and never pushed (it crashed), so a
# retry is that same round again, not a new one.
marked=$(jq -r --arg l "$JOB_LOGIN" 'select(.[0] == $l) | .[1]' <<<"$comments" \
  | grep -oE 'review-loop-round:[0-9a-f]{40}' | cut -d: -f2 || true)
git fetch -q origin "$base"
rounds=0
while IFS=$'\t' read -r sha email; do
  if [ "$sha" != "$head_sha" ] && grep -qxF -- "$sha" <<<"$marked"; then
    rounds=$((rounds + 1))
  fi
  case "$email" in *"[bot]"*) ;; *) break ;; esac
done < <(git log "origin/$base..HEAD" --first-parent --format='%H%x09%ae')

if [ "$rounds" -ge "$MAX_ROUNDS" ]; then
  emit escalate "" "$rounds rounds spent since the last human touch"
  exit 0
fi

# Spend the round before announcing it: a round whose marker cannot be written must not run, and
# a marker posted under another login would never count, leaving the loop uncapped.
round=$((rounds + 1))
if ! grep -qxF -- "$head_sha" <<<"$marked"; then
  author=$(gh api "repos/$GITHUB_REPOSITORY/issues/$pr/comments" -X POST --jq '.user.login' \
    -f body="🔁 Review loop round $round of $MAX_ROUNDS on ${head_sha:0:7}.

<!-- ${GITHUB_REPOSITORY#*/}:review-loop-round:$head_sha -->") \
    || { echo "::error::could not record round $round on PR #$pr"; exit 1; }
  [ "$author" = "$JOB_LOGIN" ] \
    || { echo "::error::round marker posted as '$author', not $JOB_LOGIN — GH_TOKEN must be the workflow's GITHUB_TOKEN"; exit 1; }
fi
emit round "$round"
