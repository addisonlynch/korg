#!/usr/bin/env bash
# Count the reviews submitted on a PR.
#
# Usage:   pr-review-count <pr-number>
# Env:     GH_TOKEN, GITHUB_REPOSITORY — for `gh pr view`
#          GITHUB_OUTPUT              — `count` appended, when set
# Output:  prints the count, or nothing if it could not be read.
# Exit:    0 always. An unreadable count prints empty rather than failing, because the caller
#          (verify-review-submitted) treats "missing" as a fail-closed signal of its own — this
#          runs once before the reviewer, where going red would block the review it is measuring.
set -euo pipefail

pr="${1:?usage: pr-review-count <pr-number>}"
: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"

count=$(gh pr view "$pr" --repo "$GITHUB_REPOSITORY" --json reviews --jq '.reviews | length') || count=""

[ -z "${GITHUB_OUTPUT:-}" ] || echo "count=$count" >> "$GITHUB_OUTPUT"
echo "$count"
