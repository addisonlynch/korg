#!/usr/bin/env bash
# Mint a Linear app-actor token (the workspace's OAuth app) via the client_credentials grant and
# export it as LINEAR_API_KEY for every later step in the job, masked from logs. CI acts as the
# app, never as the human: personal notifications are suppressed for one's own actions, so
# assignments/mentions written under the human's key would never ping them.
#
# The token is valid 30 days but minted fresh per job; nothing stores or refreshes it. The scope
# string must stay IDENTICAL across every mint — Linear revokes all outstanding app tokens when a
# mint requests a different scope. Rotating the client secret also revokes them all.
#
# Consumers send the token as a bare `Authorization:` header (every korg bin script); an MCP
# client may send `Bearer`. Linear accepts the app-actor token in both forms.
#
# Usage:   linear-agent-token
# Env:     LINEAR_CLIENT_ID      — OAuth app client id (required)
#          LINEAR_CLIENT_SECRET  — OAuth app client secret (required)
#          GITHUB_ENV            — set by the runner (required)
# Exit:    0 with LINEAR_API_KEY exported; non-zero on any HTTP or parse failure, so a revoked
#          secret reds the job instead of letting later steps fail on an empty key.
set -euo pipefail

: "${LINEAR_CLIENT_ID:?LINEAR_CLIENT_ID is required}"
: "${LINEAR_CLIENT_SECRET:?LINEAR_CLIENT_SECRET is required}"
: "${GITHUB_ENV:?GITHUB_ENV is required}"

# Form body built urlencoded (credentials containing form metacharacters must not corrupt the
# fields) and passed over stdin, never argv: the client secret must not be visible via ps//proc
# on a shared self-hosted runner for the lifetime of the request.
body=$(python3 -c "import os, urllib.parse
print(urllib.parse.urlencode({
    'grant_type': 'client_credentials',
    'client_id': os.environ['LINEAR_CLIENT_ID'],
    'client_secret': os.environ['LINEAR_CLIENT_SECRET'],
    'scope': 'read,write,app:assignable,app:mentionable',
}))")

# --fail-with-body still fails loudly on HTTP >= 400 but keeps the OAuth error body, which is
# what tells a rotated secret ("invalid_client") apart from a scope mismatch in the job log.
if ! resp=$(printf '%s' "$body" | curl -sS --fail-with-body --max-time 20 \
  -X POST https://api.linear.app/oauth/token \
  -H "Content-Type: application/x-www-form-urlencoded" -d @-); then
  echo "OAuth token mint failed: $resp" >&2
  exit 1
fi

token=$(printf '%s' "$resp" | python3 -c "import json, sys
t = json.load(sys.stdin).get('access_token')
if not isinstance(t, str) or not t:
    raise SystemExit('no usable access_token in the OAuth response')
print(t)")

echo "::add-mask::$token"
echo "LINEAR_API_KEY=$token" >> "$GITHUB_ENV"
