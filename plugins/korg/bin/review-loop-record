#!/usr/bin/env bash
# Record a loop round as an empty commit in the branch's history.
#
# Usage:   review-loop-record <round>
# Exit:    0 the record commit exists locally; 1 otherwise.
#
# Runs inside the PR branch checkout, BEFORE the fix agent, and only COMMITS — it never
# pushes. The agent's own /korg:commit push carries this commit along as the fix's parent, so
# the round reaches the remote exactly when the round actually produced something. A
# round that pushes nothing leaves the head untouched: no push means no synchronize, no fresh
# review, and no next trigger — the loop halts on the still-red check.
#
# Never add `[skip ci]` to this message. GitHub honours it for `pull_request` too, so when a
# pushless round makes this commit the head it suppresses every trigger — CI, review, even a
# label re-add — and the PR wedges permanently with no way back but a new commit.
# The author identity must keep the `[bot]` suffix review-loop-gate uses to tell bot commits
# from human ones, or this commit would reset the budget.
set -euo pipefail

round="${1:?usage: review-loop-record <round>}"

git -c user.name="github-actions[bot]" \
    -c user.email="41898282+github-actions[bot]@users.noreply.github.com" \
  commit --allow-empty \
  -m "Review loop: record fix round $round"
echo "recorded round $round locally — it lands with the agent's push"
