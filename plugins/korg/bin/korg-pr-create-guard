#!/usr/bin/env bash
# PreToolUse hook for Bash: refuses `gh pr create`, and a POST to the pulls API, unless
# /korg:open-pr has written its sentinel for the current branch:
# /tmp/open-pr-active-<branch with / replaced by _>. Exit 2 blocks the tool call.
set -euo pipefail

cmd=$(jq -r '.tool_input.command // ""')
grep -Eq '(^|[;&|(]|\$\()[[:space:]]*gh (pr create|api [^;&|]*(--method[[:space:]]+POST|-X[[:space:]]+POST)[^;&|]*/pulls([[:space:]]|$))' <<<"$cmd" || exit 0

b=$( (git rev-parse --abbrev-ref HEAD 2>/dev/null || true) | tr '/' '_')
[ -f "/tmp/open-pr-active-$b" ] && exit 0

echo 'BLOCKED: PRs are opened only through /korg:open-pr. Run /korg:open-pr instead of gh pr create.' >&2
exit 2
